# dependencies
node_modules/

# next.js
.next/
out/
next-env.d.ts
*.tsbuildinfo

# env — NEVER commit; .env.local holds the scoped Pinata JWT
.env
.env.*
!.env.example
# wrangler dev's local secrets file (the pay worker's e2e test writes one). Not
# matched by .env.* above, which is how it would have slipped into a commit.
.dev.vars
.dev.vars.*

# wrangler local state — miniflare's local KV sqlite and scratch dirs.
# Note: a stray local KV store is why `wrangler kv key delete` can look like a
# no-op; the deployed worker's own read is the authoritative check.
.wrangler/

# misc
.DS_Store
