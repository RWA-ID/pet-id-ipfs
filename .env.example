# WalletConnect — https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# The PetID registrar (mainnet). The variable keeps its V4 name, but point it at
# PetIDRegistrarV5 (0xe189666820863F6e7c578c81eFd7ED9eAb24d1bb): same crypto
# checkout, plus custody for card orders.
NEXT_PUBLIC_PETID_REGISTRAR_V4_ADDRESS=

# Card payments (worker/wrangler.pay.toml). Leave either unset and the site
# simply doesn't offer card checkout.
NEXT_PUBLIC_PAY_API=
# Google Cloud Console → Google Auth Platform → Clients. Public, not a secret.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# USDC (mainnet). Defaults to this address if unset.
NEXT_PUBLIC_USDC_ADDRESS=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48

# RPC endpoints
NEXT_PUBLIC_RPC_URL_MAINNET=https://eth.llamarpc.com
NEXT_PUBLIC_RPC_URL_SEPOLIA=

# Partner application endpoint (worker/ — `wrangler deploy`, then paste the URL).
# Unset: the partner form falls back to a prefilled email + copyable block.
NEXT_PUBLIC_PARTNER_APPLY_URL=

# Pinata — create a scoped JWT with only Files:write permission
# https://app.pinata.cloud/developers/api-keys
PINATA_JWT=
NEXT_PUBLIC_PINATA_GATEWAY=https://gateway.pinata.cloud
